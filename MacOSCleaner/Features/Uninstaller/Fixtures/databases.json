{
  "category": "databases",
  "description": "Базы данных, их клиенты и менеджеры",
  "apps": [
    {
      "name": "PostgreSQL (Postgres.app)",
      "bundle_id": "com.postgresapp.Postgres2",
      "difficulty": "high",
      "notes": "Устанавливает PostgreSQL сервер. Может конфликтовать с Homebrew PostgreSQL.",
      "paths": {
        "applications": ["/Applications/Postgres.app"],
        "application_support": [
          "~/Library/Application Support/Postgres",
          "~/Library/Application Support/Postgres/var-*"
        ],
        "caches": ["~/Library/Caches/com.postgresapp.Postgres2"],
        "preferences": ["~/Library/Preferences/com.postgresapp.Postgres2.plist"],
        "saved_state": ["~/Library/Saved Application State/com.postgresapp.Postgres2.savedState"],
        "other": ["~/Library/Containers/com.postgresapp.Postgres2"]
      }
    },
