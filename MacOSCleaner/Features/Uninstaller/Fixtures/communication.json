    {
      "name": "Telegram",
      "bundle_id": "ru.keepcoder.Telegram",
      "difficulty": "medium",
      "notes": "Много Application Scripts, Containers, Group Containers. Использует iCloud.",
      "paths": {
        "applications": ["/Applications/Telegram.app"],
        "application_support": ["~/Library/Application Support/ru.keepcoder.Telegram"],
        "containers": [
          "~/Library/Containers/ru.keepcoder.Telegram",
          "~/Library/Containers/ru.keepcoder.Telegram.TelegramShare"
        ],
        "group_containers": [
          "~/Library/Group Containers/*.ru.keepcoder.Telegram",
          "~/Library/Group Containers/*.ru.keepcoder.Telegram.TelegramShare"
        ],
        "caches": [
          "~/Library/Caches/ru.keepcoder.Telegram",
          "~/Library/Caches/com.plausiblelabs.crashreporter.data/ru.keepcoder.Telegram"
        ],
        "preferences": ["~/Library/Preferences/ru.keepcoder.Telegram.plist"],
        "saved_state": ["~/Library/Saved Application State/ru.keepcoder.Telegram.savedState"],
        "cookies": ["~/Library/Cookies/ru.keepcoder.Telegram.binarycookies"],
        "http_storages": ["~/Library/HTTPStorages/ru.keepcoder.Telegram"],
        "application_scripts": [
          "~/Library/Application Scripts/*.ru.keepcoder.Telegram",
          "~/Library/Application Scripts/*.ru.keepcoder.Telegram.TelegramShare",
          "~/Library/Application Scripts/ru.keepcoder.Telegram",
          "~/Library/Application Scripts/ru.keepcoder.Telegram.TelegramShare"
        ]
      }
