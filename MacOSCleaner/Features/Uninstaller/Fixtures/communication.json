    {
      "name": "Zoom",
      "bundle_id": "us.zoom.xos",
      "difficulty": "high",
      "notes": "Устанавливает pkg, kext (ранее), PrivilegedHelperTools, LaunchDaemons. Много системных компонентов.",
      "paths": {
        "applications": ["/Applications/zoom.us.app"],
        "launch_agents": [],
        "launch_daemons": [
          "com.zoom.updater",
          "com.zoom.updater.login.check",
          "us.zoom.ZoomDaemon"
        ],
        "privileged_helper_tools": ["/Library/PrivilegedHelperTools/us.zoom.ZoomDaemon"],
        "application_support": [
          "~/Library/Application Support/zoom.us",
          "~/Library/Application Support/ZoomUpdater"
        ],
        "group_containers": ["~/Library/Group Containers/*.ZoomClient3rd"],
        "caches": ["~/Library/Caches/us.zoom.xos"],
        "preferences": [
          "~/Library/Preferences/us.zoom.*.plist",
          "~/Library/Preferences/ZoomChat.plist"
        ],
        "logs": [
          "~/Library/Logs/zoom.us",
          "~/Library/Logs/zoominstall.log",
          "~/Library/Logs/ZoomPhone"
        ],
        "saved_state": ["~/Library/Saved Application State/us.zoom.xos.savedState"],
        "cookies": ["~/Library/Cookies/us.zoom.xos.binarycookies"],
        "http_storages": [
          "~/Library/HTTPStorages/us.zoom.xos",
          "~/Library/HTTPStorages/us.zoom.xos.binarycookies"
        ],
        "webkit": ["~/Library/WebKit/us.zoom.xos"],
        "application_scripts": ["~/Library/Application Scripts/*.ZoomClient3rd"],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/us.zoom*.sfl*"
        ],
        "internet_plugins": [
          "/Library/Internet Plug-Ins/ZoomUsPlugIn.plugin",
          "~/Library/Internet Plug-Ins/ZoomUsPlugIn.plugin"
        ],
        "diagnostic_reports": [
          "~/Library/Application Support/CrashReporter/zoom.us*",
          "/Library/Logs/DiagnosticReports/zoom.us*"
        ],
        "cloud_docs": [
          "~/Library/Application Support/CloudDocs/session/containers/iCloud.us.zoom.videomeetings",
          "~/Library/Application Support/CloudDocs/session/containers/iCloud.us.zoom.videomeetings.plist"
        ],
        "pkg_receipts": ["us.zoom.pkg.videomeeting"],
        "other": [
          "~/.zoomus",
          "~/Desktop/Zoom",
          "~/Documents/Zoom"
        ]
      }
    },
    {
