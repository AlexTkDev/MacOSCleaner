{
  "category": "communication",
  "description": "Мессенджеры, почтовые клиенты, видеоконференции",
  "apps": [
    {
      "name": "Slack",
      "bundle_id": "com.tinyspeck.slackmacgap",
      "difficulty": "medium",
      "notes": "Использует Containers, Group Containers, Application Scripts. Много файлов в shared file lists.",
      "paths": {
        "applications": ["/Applications/Slack.app"],
        "launch_agents": [],
        "launch_daemons": [],
        "application_support": ["~/Library/Application Support/Slack"],
        "containers": [
          "~/Library/Containers/com.tinyspeck.slackmacgap",
          "~/Library/Containers/com.tinyspeck.slackmacgap*"
        ],
        "group_containers": [
          "~/Library/Group Containers/*.com.tinyspeck.slackmacgap",
          "~/Library/Group Containers/*.slack"
        ],
        "caches": ["~/Library/Caches/com.tinyspeck.slackmacgap*"],
        "preferences": ["~/Library/Preferences/com.tinyspeck.slackmacgap*"],
        "logs": ["~/Library/Logs/Slack"],
        "saved_state": ["~/Library/Saved Application State/com.tinyspeck.slackmacgap.savedState"],
        "cookies": ["~/Library/Cookies/com.tinyspeck.slackmacgap.binarycookies"],
        "http_storages": ["~/Library/HTTPStorages/com.tinyspeck.slackmacgap*"],
        "webkit": ["~/Library/WebKit/com.tinyspeck.slackmacgap"],
        "application_scripts": ["~/Library/Application Scripts/com.tinyspeck.slackmacgap"],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.tinyspeck.slackmacgap.sfl*"
        ],
        "diagnostic_reports": ["/Library/Logs/DiagnosticReports/Slack_*"]
      }
    },
