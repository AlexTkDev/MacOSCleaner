{
  "category": "utilities",
  "description": "Утилиты разработчика, редакторы, терминалы",
  "apps": [
    {
      "name": "Visual Studio Code",
      "bundle_id": "com.microsoft.VSCode",
      "difficulty": "medium",
      "notes": "Оставляет расширения, настройки, кэши. Использует ShipIt updater.",
      "paths": {
        "applications": ["/Applications/Visual Studio Code.app"],
        "launch_agents": ["com.microsoft.VSCode.ShipIt"],
        "application_support": [
          "~/Library/Application Support/Code",
          "~/.vscode"
        ],
        "caches": [
          "~/Library/Caches/com.microsoft.VSCode",
          "~/Library/Caches/com.microsoft.VSCode.ShipIt"
        ],
        "preferences": [
          "~/Library/Preferences/com.microsoft.VSCode.plist",
          "~/Library/Preferences/com.microsoft.VSCode.helper.plist",
          "~/Library/Preferences/ByHost/com.microsoft.VSCode.ShipIt.*.plist"
        ],
        "saved_state": ["~/Library/Saved Application State/com.microsoft.VSCode.savedState"],
        "http_storages": ["~/Library/HTTPStorages/com.microsoft.VSCode"],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.microsoft.vscode.sfl*"
        ]
      }
    },
    {
      "name": "Sublime Text",
      "bundle_id": "com.sublimetext.4",
      "difficulty": "medium",
      "notes": "Может использовать папки от предыдущих версий (Sublime Text 3).",
      "paths": {
        "applications": ["/Applications/Sublime Text.app"],
        "application_support": [
          "~/Library/Application Support/Sublime Text",
          "~/Library/Application Support/Sublime Text 3",
          "~/Library/Application Support/Sublime Text (Safe Mode)"
        ],
        "caches": [
          "~/Library/Caches/com.sublimetext.4",
          "~/Library/Caches/com.sublimetext.3",
          "~/Library/Caches/Sublime Text",
          "~/Library/Caches/Sublime Text 3",
          "~/Library/Caches/Sublime Text (Safe Mode)"
        ],
        "preferences": [
          "~/Library/Preferences/com.sublimetext.4.plist",
          "~/Library/Preferences/com.sublimetext.3.plist"
        ],
        "saved_state": [
          "~/Library/Saved Application State/com.sublimetext.4.savedState",
          "~/Library/Saved Application State/com.sublimetext.3.savedState"
        ],
        "http_storages": [
          "~/Library/HTTPStorages/com.sublimetext.4",
          "~/Library/HTTPStorages/com.sublimetext.3"
        ],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.sublimetext.4.sfl*"
        ]
      }
    },
    {
      "name": "Postman",
