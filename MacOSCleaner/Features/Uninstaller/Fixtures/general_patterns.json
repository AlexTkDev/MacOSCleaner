      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-journal",
      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-shm",
      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-wal",
      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-lock",
      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-journal",
      "~/Library/Caches/Metadata/CoreSpotlight/SpotlightConfig.plist-shm",
