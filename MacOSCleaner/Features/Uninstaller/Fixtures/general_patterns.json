      "~/Library/Group Containers/[groupID]/[AppName]",
      "~/Library/HTTPStorages/[bundleID]",
      "~/Library/HTTPStorages/[bundleID]/storage.sqlite",
      "~/Library/HTTPStorages/[bundleID]/cookies.sqlite",
