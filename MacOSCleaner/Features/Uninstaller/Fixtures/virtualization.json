{
  "category": "virtualization",
  "description": "Виртуализация, контейнеры",
  "apps": [
    {
      "name": "Docker Desktop",
      "bundle_id": "com.docker.docker",
      "difficulty": "critical",
      "notes": "Устанавливает виртуальную машину, сетевые интерфейсы, множество системных компонентов. Оставляет огромные образы.",
      "paths": {
        "applications": ["/Applications/Docker.app"],
        "launch_agents": [
          "com.docker.helper",
          "com.docker.socket"
        ],
        "launch_daemons": [
          "com.docker.vmnetd",
          "com.docker.socket"
        ],
        "application_support": [
          "~/Library/Application Support/Docker Desktop",
          "~/Library/Containers/com.docker.docker",
          "~/Library/Containers/com.docker.helper"
        ],
        "caches": [
          "~/Library/Caches/com.docker.docker",
          "~/Library/Caches/Docker"
        ],
        "preferences": [
          "~/Library/Group Containers/group.com.docker",
          "~/Library/Preferences/com.docker.docker.plist"
        ],
        "logs": [
          "~/Library/Logs/Docker Desktop",
          "~/Library/Containers/com.docker.docker/Data/log"
        ],
        "saved_state": ["~/Library/Saved Application State/com.electron.docker-frontend.savedState"],
        "group_containers": ["~/Library/Group Containers/group.com.docker"],
        "containers": [
          "~/Library/Containers/com.docker.docker",
          "~/Library/Containers/com.docker.helper"
        ],
        "other": [
          "~/.docker",
          "~/Library/Group Containers/group.com.docker",
          "~/Library/Application Scripts/com.docker.helper"
        ]
      }
    },
    {
      "name": "Parallels Desktop",
      "bundle_id": "com.parallels.desktop.console",
      "difficulty": "critical",
      "notes": "Полноценный гипервизор. Устанавливает kext, системные расширения, множество бинарников в /usr/local/bin.",
      "paths": {
        "applications": ["/Applications/Parallels Desktop.app"],
        "application_support": [
          "~/Library/Application Support/Parallels",
          "~/Library/Parallels"
        ],
        "caches": [
          "~/Library/Caches/com.parallels.desktop.console",
          "~/Library/Caches/Parallels Software/Parallels Desktop"
        ],
        "preferences": [
          "~/Library/Preferences/com.parallels.desktop.console.plist",
          "~/Library/Preferences/com.parallels.Parallels Desktop.plist",
          "~/Library/Preferences/com.parallels.Parallels.plist",
          "~/Library/Preferences/com.parallels.PDInfo.plist",
          "~/Library/Preferences/Parallels"
        ],
        "saved_state": ["~/Library/Saved Application State/com.parallels.desktop.console.savedState"],
        "application_scripts": ["~/Library/Application Scripts/*.com.parallels.Desktop"],
        "containers": ["~/Library/Containers/com.parallels.desktop*"],
        "group_containers": ["~/Library/Group Containers/*.com.parallels.Desktop"],
        "logs": ["~/Library/Logs/parallels.log"],
        "other": [
          "~/.parallels_settings",
          "~/Applications (Parallels)",
          "~/Library/Parallels/Applications Menus",
          "~/Library/Parallels/Downloads",
          "~/Library/Parallels/Parallels Desktop",
          "/usr/local/bin/prl_convert",
          "/usr/local/bin/prl_disk_tool",
          "/usr/local/bin/prl_perf_ctl",
          "/usr/local/bin/prlcopy",
          "/usr/local/bin/prlcore2dmp",
          "/usr/local/bin/prlctl",
          "/usr/local/bin/prlexec",
          "/usr/local/bin/prlsrvctl",
          "/Users/Shared/Parallels"
        ]
      }
    },
    {
      "name": "VirtualBox",
      "bundle_id": "org.virtualbox.app.VirtualBox",
      "difficulty": "critical",
      "notes": "Устанавливает kext, pkg. Оставляет виртуальные машины.",
      "paths": {
        "applications": ["/Applications/VirtualBox.app"],
        "application_support": [
          "~/Library/Application Support/VirtualBox",
          "/Library/Application Support/VirtualBox"
        ],
        "preferences": ["~/Library/Preferences/org.virtualbox.app.VirtualBox*"],
        "saved_state": ["~/Library/Saved Application State/org.virtualbox.app.VirtualBox*"],
        "other": [
          "~/VirtualBox VMs",
          "/usr/local/bin/vboximg-mount"
        ],
        "pkg_receipts": ["org.virtualbox.pkg.*"]
      }
    },
    {
      "name": "UTM",
      "bundle_id": "com.utmapp.UTM",
      "difficulty": "medium",
      "notes": "QEMU-based виртуализация. Использует Containers и Group Containers.",
      "paths": {
        "applications": ["/Applications/UTM.app"],
        "preferences": ["~/Library/Preferences/com.utmapp.UTM.plist"],
        "saved_state": ["~/Library/Saved Application State/com.utmapp.UTM.savedState"],
        "application_scripts": ["~/Library/Application Scripts/*com.utmapp*"],
        "containers": ["~/Library/Containers/com.utmapp*"],
        "group_containers": ["~/Library/Group Containers/*.com.utmapp.UTM"]
      }
    },
    {
      "name": "VMware Fusion",
      "bundle_id": "com.vmware.fusion",
      "difficulty": "critical",
      "notes": "Гипервизор. Устанавливает kext, системные расширения.",
      "paths": {
        "applications": ["/Applications/VMware Fusion.app"],
        "application_support": [
          "~/Library/Application Support/VMware Fusion",
          "/Library/Application Support/VMware"
        ],
        "caches": ["~/Library/Caches/com.vmware.fusion"],
        "preferences": [
          "~/Library/Preferences/com.vmware.fusion.plist",
          "~/Library/Preferences/com.vmware.fusionStartMenu.plist"
        ],
        "saved_state": ["~/Library/Saved Application State/com.vmware.fusion.savedState"],
        "other": [
          "~/Virtual Machines",
          "/Library/Application Support/VMware",
          "/Library/Preferences/VMware Fusion"
        ]
      }
    },
    {
      "name": "QEMU",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "CLI виртуализация. Обычно устанавливается через Homebrew.",
      "paths": {
        "other": [
          "/opt/homebrew/bin/qemu-system-*",
          "/usr/local/bin/qemu-system-*",
          "~/.config/qemu"
        ]
      }
    }
  ]
}