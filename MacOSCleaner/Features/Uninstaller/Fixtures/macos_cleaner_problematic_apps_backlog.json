  "general_patterns": {
    "description": "Общие паттерны leftover-файлов для любого приложения macOS",
    "standard_paths": [
      "~/Library/Application Support/[AppName]",
      "~/Library/Application Support/[DeveloperName]/[AppName]",
      "~/Library/Caches/[bundleID]",
      "~/Library/Caches/[AppName]",
      "~/Library/Preferences/[bundleID].plist",
      "~/Library/Preferences/[DeveloperName].[AppName].plist",
      "~/Library/Logs/[AppName]",
      "~/Library/Logs/[bundleID]",
      "~/Library/Saved Application State/[bundleID].savedState",
      "~/Library/WebKit/[bundleID]",
      "~/Library/Containers/[bundleID]",
      "~/Library/Group Containers/[groupID]",
      "/Library/Application Support/[AppName]",
      "/Library/Caches/[AppName]",
      "/Library/Preferences/[bundleID].plist",
      "/Library/LaunchAgents/[bundleID].plist",
      "/Library/LaunchDaemons/[bundleID].plist",
      "/Library/PrivilegedHelperTools/[bundleID]",
      "/Library/Extensions/[KextName].kext",
      "/Library/StagedExtensions/Library/Extensions/[KextName].kext"
    ],
    "edge_cases": [
      "Apps with custom installers (pkg) — оставляют receipt в /var/db/receipts/",
      "Sandboxed apps — данные в ~/Library/Containers, не всегда связаны с bundleID",
      "Group Containers — shared между несколькими app от одного developer",
      "System Extensions — требуют systemextensionsctl для удаления",
      "Kernel Extensions — требуют kmutil unload + reboot",
      "Background processes — нужно убивать через Activity Monitor или killall",
      "Login Items — остаются в System Settings > General > Login Items",
      "Browser extensions — остаются в profile data браузера"
    ]
  }
