{
  "category": "package_managers",
  "description": "Менеджеры пакетов, зависимостей",
  "apps": [
    {
      "name": "Homebrew",
      "bundle_id": null,
      "difficulty": "critical",
      "notes": "Не приложение, а CLI tool. Устанавливается в /opt/homebrew или /usr/local. Оставляет огромное количество файлов.",
      "paths": {
        "caches": [
          "~/Library/Caches/Homebrew",
          "~/Library/Caches/Homebrew/downloads"
        ],
        "other": [
          "/opt/homebrew",
          "/usr/local/Homebrew",
          "~/.brew",
          "~/.homebrew",
          "~/.cache/Homebrew"
        ]
      }
    },
    {
      "name": "MacPorts",
      "bundle_id": null,
      "difficulty": "critical",
      "notes": "Устанавливается в /opt/local. Оставляет огромное количество файлов.",
      "paths": {
        "other": [
          "/opt/local",
          "/Applications/MacPorts",
          "~/.macports"
        ]
      }
    },
    {
      "name": "Anaconda/Miniconda",
      "bundle_id": null,
      "difficulty": "high",
      "notes": "Устанавливается в ~/opt или /opt. Создает множество окружений.",
      "paths": {
        "applications": ["/Applications/Anaconda-Navigator.app"],
        "application_support": ["~/Library/Application Support/Anaconda"],
        "caches": ["~/Library/Caches/continuum.io"],
        "preferences": ["~/Library/Preferences/com.continuum.io.plist"],
        "other": [
          "~/anaconda3",
          "~/miniconda3",
          "~/opt/anaconda3",
          "~/opt/miniconda3",
          "~/.conda",
          "~/.condarc",
          "~/.continuum"
        ]
      }
    },
    {
      "name": "nvm",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "Node Version Manager. CLI tool.",
      "paths": {
        "other": [
          "~/.nvm",
          "~/.npm",
          "~/.node-gyp"
        ]
      }
    },
    {
      "name": "rbenv",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "Ruby Version Manager. CLI tool.",
      "paths": {
        "other": [
          "~/.rbenv",
          "~/.gem",
          "~/.bundle"
        ]
      }
    },
    {
      "name": "pyenv",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "Python Version Manager. CLI tool.",
      "paths": {
        "other": [
          "~/.pyenv",
          "~/.python_history"
        ]
      }
    },
    {
      "name": "asdf",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "Универсальный version manager.",
      "paths": {
        "other": [
          "~/.asdf",
          "~/.tool-versions"
        ]
      }
    },
    {
      "name": "pip",
      "bundle_id": null,
      "difficulty": "low",
      "notes": "Python package manager. Оставляет кэш и конфиги.",
      "paths": {
        "other": [
          "~/.cache/pip",
          "~/.local/lib/python*",
          "~/.config/pip"
        ]
      }
    },
    {
      "name": "npm/yarn/pnpm",
      "bundle_id": null,
      "difficulty": "medium",
      "notes": "Node package managers. Оставляют глобальные пакеты и кэш.",
      "paths": {
        "other": [
          "~/.npm",
          "~/.yarn",
          "~/.pnpm-store",
          "~/.config/yarn",
          "~/node_modules",
          "~/.cache/yarn",
          "~/.cache/pnpm"
        ]
      }
    },
    {
      "name": "CocoaPods",
      "bundle_id": null,
      "difficulty": "low",
      "notes": "Dependency manager для iOS/macOS.",
      "paths": {
        "other": [
          "~/.cocoapods",
          "~/.podrc"
        ]
      }
    },
    {
      "name": "Swift Package Manager",
      "bundle_id": null,
      "difficulty": "low",
      "notes": "Встроен в Xcode. Кэш в ~/Library/Caches.",
      "paths": {
        "caches": [
          "~/Library/Caches/org.swift.swiftpm",
          "~/Library/Caches/swift-package-manager"
        ],
        "other": [
          "~/.swiftpm",
          "~/.netrc"
        ]
      }
    }
  ]
}