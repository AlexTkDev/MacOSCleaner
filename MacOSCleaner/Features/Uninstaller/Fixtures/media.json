{
  "category": "media",
  "description": "Видео, аудио, стриминг, графические редакторы",
  "apps": [
    {
      "name": "Spotify",
      "bundle_id": "com.spotify.client",
      "difficulty": "medium",
      "notes": "Использует web helper, startup helper. Много launchctl сервисов с wildcard.",
      "paths": {
        "applications": ["/Applications/Spotify.app"],
        "launch_agents": [
          "com.spotify.client.startuphelper",
          "com.spotify.webhelper",
          "*.spotify.client.*"
        ],
        "application_support": ["~/Library/Application Support/Spotify"],
        "caches": [
          "~/Library/Caches/com.spotify.client",
          "~/Library/Caches/com.spotify.client.helper"
        ],
        "preferences": [
          "~/Library/Preferences/com.spotify.client.plist",
          "~/Library/Preferences/com.spotify.client.helper.plist"
        ],
        "logs": ["~/Library/Logs/Spotify"],
        "saved_state": ["~/Library/Saved Application State/com.spotify.client.savedState"],
        "cookies": ["~/Library/Cookies/com.spotify.client.binarycookies"],
        "http_storages": [
          "~/Library/HTTPStorages/com.spotify.client",
          "~/Library/HTTPStorages/com.spotify.client.helper"
        ],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.spotify.client.startuphelper.sfl*"
        ]
      }
    },
    {
      "name": "VLC",
      "bundle_id": "org.videolan.vlc",
      "difficulty": "low",
      "notes": "Относительно чистое приложение, но имеет shim script и плагины.",
      "paths": {
        "applications": ["/Applications/VLC.app"],
        "application_support": [
          "~/Library/Application Support/org.videolan.vlc",
          "~/Library/Application Support/VLC"
        ],
        "caches": ["~/Library/Caches/org.videolan.vlc"],
        "preferences": [
          "~/Library/Preferences/org.videolan.vlc",
          "~/Library/Preferences/org.videolan.vlc.plist"
        ],
        "saved_state": ["~/Library/Saved Application State/org.videolan.vlc.savedState"],
        "http_storages": ["~/Library/HTTPStorages/org.videolan.vlc"],
        "shared_file_lists": [
          "~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/org.videolan.vlc.sfl*"
        ]
      }
    },
    {
      "name": "OBS Studio",
      "bundle_id": "com.obsproject.obs-studio",
      "difficulty": "medium",
      "notes": "Устанавливает виртуальную камеру (CoreMediaIO plugin). Много плагинов.",
      "paths": {
        "applications": ["/Applications/OBS.app"],
        "application_support": ["~/Library/Application Support/obs-studio"],
        "preferences": ["~/Library/Preferences/com.obsproject.obs-studio.plist"],
        "saved_state": ["~/Library/Saved Application State/com.obsproject.obs-studio.savedState"],
        "http_storages": ["~/Library/HTTPStorages/com.obsproject.obs-studio"],
        "plugins": ["/Library/CoreMediaIO/Plug-Ins/DAL/obs-mac-virtualcam.plugin"]
      }
    },
    {
      "name": "Adobe Photoshop",
      "bundle_id": "com.adobe.Photoshop",
      "difficulty": "critical",
      "notes": "Часть Adobe Creative Cloud. Огромное количество системных файлов, сервисов, плагинов.",
      "paths": {
        "applications": [
          "/Applications/Adobe Photoshop 2026.app",
          "/Applications/Adobe Photoshop 2025.app"
        ],
        "launch_agents": [
          "com.adobe.ccxprocess",
          "com.adobe.GC.AGM",
          "com.adobe.GC.Invoker-1.0"
        ],
        "launch_daemons": [
          "com.adobe.acc.installer",
          "com.adobe.acc.installer.v2",
          "com.adobe.AdobeDesktopService",
          "com.adobe.agsservice",
          "com.adobe.ARMDCHelper.cc24a91db67c90d76f411d88f17f9d7e",
          "com.adobe.GC.Scheduler-1.0"
        ],
        "application_support": [
          "~/Library/Application Support/Adobe/Adobe Photoshop 2026",
          "~/Library/Application Support/Adobe/Adobe Photoshop 2025",
          "~/Library/Application Support/Adobe/OOBE",
          "~/Library/Application Support/Adobe/CEP"
        ],
        "caches": [
          "~/Library/Caches/com.adobe.Photoshop",
          "~/Library/Caches/Adobe/Photoshop"
        ],
        "preferences": [
          "~/Library/Preferences/com.adobe.Photoshop.plist",
          "~/Library/Preferences/Adobe Photoshop * Settings"
        ],
        "logs": [
          "~/Library/Logs/Adobe/Photoshop",
          "~/Library/Logs/CreativeCloud"
        ],
        "other": [
          "~/Library/Preferences/Adobe/Photoshop",
          "/Library/Application Support/Adobe/Adobe Photoshop",
          "/Library/Application Support/Adobe/CEP/extensions",
          "/Library/Application Support/regid.*.com.adobe",
          "~/Library/Application Support/CrashReporter/AdobeCRDaemon_*.plist"
        ]
      }
    },
